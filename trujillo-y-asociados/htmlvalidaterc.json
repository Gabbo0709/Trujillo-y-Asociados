{
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "rules": {
    "heading-level": "error",
    "element-required-ancestor": "error",
    "no-inline-style": "warn",
    "require-sri": "off",
    "attr-case": "error",
    "no-dup-attr": "error",
    "no-unknown-elements": "error",
    "valid-id": "error",
    "doctype-html": "error",
    "input-missing-label": "error"
  }
}