{
  "ci": {
    "collect": {
      "staticDistDir": "./trujillo-y-asociados/dist",
      "url": [
        "/",
        "/firm/",
        "/contacto/",
        "/corporate-advisory/",
        "/workers-advisory/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.90
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}