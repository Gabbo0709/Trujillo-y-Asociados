{
  "name": "trujillo-y-asociados",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:links": "linkinator ./dist --recurse --skip \"^https?://(www\\.)?(linkedin|facebook|twitter|trujillo-demo\\.netlify\\.app)\"",
    "ci:validate": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:html && pnpm run test:links",
    "extract-seo-payload": "NODE_PATH=./node_modules tsx ../.agents/scripts/extract-seo-payload.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.8",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/ts-plugin": "^1.10.10",
    "happy-dom": "^20.11.1",
    "html-validate": "^11.5.6",
    "linkinator": "^8.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "cheerio": "1.2.0",
    "tsx": "4.23.1"
  }
}