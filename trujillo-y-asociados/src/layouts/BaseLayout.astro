---
import '@styles/global.css';
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';

export interface SchemaData {
    '@context': 'https://schema.org';
    '@type': string;
    [key: string]: unknown;
}

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    noIndex?: boolean;
    schema?: SchemaData;
}

const { 
    title,
    description,
    ogImage = '/images/og-default.jpg',
    noIndex = false,
    schema
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImageUrl = new URL(ogImage, Astro.site);

const defaultSchema: SchemaData = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trujillo & Asociados Abogados',
    url: Astro.site?.toString() ?? canonicalUrl.toString(),
    'logo': new URL('/seo/og-image.png', Astro.site).toString(),
    'description': description
};

const jsonLdData = schema || defaultSchema;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Metadatos Técnicos Críticos -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href="/T_A-ICO-2.ico" />

    <!-- Control de Indexación Dinámica -->
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <!-- SEO Esencial -->
    <title>{title} | Trujillo & Asociados</title>
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook / Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Trujillo & Asociados`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Imagen descriptiva de ${title}`} />
    <meta property="og:site_name" content="Trujillo & Asociados Abogados" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | Trujillo & Asociados`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <meta name="theme-color" content="#3F1F13" media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content="#EAE2CC" media="(prefers-color-scheme: dark)"/>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Rendimiento (LCP): Pre-carga asíncrona de Web Fonts Críticas -->
    <link rel="preload" href="/fonts/Gambetta-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link 
      rel="preload" 
      href="/fonts/Roboto-Regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin="anonymous" 
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} is:inline />
    <ClientRouter />
  </head>
  <body>
    <slot name="header">
      <Header />
    </slot>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <slot name="footer">
      <Footer />
    </slot>
  </body>
</html>