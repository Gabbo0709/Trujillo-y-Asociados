---
import '@styles/font-face.css';
import '@styles/variables.css';
import '@styles/reset.css';

import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import OpenGraph from '@seo/components/OpenGraph.astro';
import Favicons from '@seo/components/Favicons.astro';
import SchemaOrg from '@seo/components/SchemaOrg.astro';
import type { SchemaData } from '@seo/types/seo.types';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: SchemaData;
}

const siteUrl = Astro.site || new URL('https://trujillo-demo.netlify.app');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);

const { title, description, ogImage, noIndex, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Metadatos Técnicos Críticos -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

        <!-- Rendimiento (LCP): Pre-carga asíncrona de Web Fonts Críticas -->
    <link rel="preload" href="/fonts/Gambetta-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Roboto-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    
    <!-- SEO Esencial -->
    <title>{title} | Trujillo &amp; Asociados</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    
    <OpenGraph {title} {description} {canonicalUrl} {ogImage} />
    <Favicons />
    <SchemaOrg {schema} {description} {canonicalUrl} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">
      Saltar al contenido principal
    </a>
    <Header />

    <main id="main-content" tabindex="-1" aria-label="Contenido Principal">
      <slot />
    </main>

    <Footer />
  </body>
</html>