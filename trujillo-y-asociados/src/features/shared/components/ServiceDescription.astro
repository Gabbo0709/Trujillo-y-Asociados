---
import type { Service } from "@shared/types/service.type";

interface Props {
    heading: string;
    services: Service[];
};

const { heading, services } = Astro.props as Props;

---
<section class="services-container" aria-labelledby="services-heading">
    <h2 id="services-heading" class="sr-only">{heading}</h2>
    {services.map((service, index) => {
    const cardTitleId = `service-title-${index}`;
    return (
      <article class="service-card" aria-labelledby={cardTitleId}>
        <h3 class="service-header" id={cardTitleId}>
          {service.title}
        </h3>
        <p class="service-description">{service.description}</p>
      </article>
    );
  })}
</section>

<style>
    .services-container {
        display: flex;
        background-color: var(--color-bg-primary);
        flex-direction: column;
        padding-inline: var(--layout-padding-inline);
        padding-block: var(--space-4);
        gap: var(--space-8);
        align-items: center;
        width: 100%;
    }
    
    .service-card {
        display: grid;
        width: 100%;
        grid-template-columns: auto 1fr;
        align-content: center;
        gap: var(--space-16);
        padding-block: var(--space-6);
        border-top: 1px solid var(--color-bg-surface);
    }

    .service-header {
        font-size: var(--text-4xl);
        font-weight: var(--font-weight-medium);
        color: var(--color-text-body);
        width: 20ch;
        line-height: 1.1;
    }

    .service-description {
        font-size: var(--text-xl);
        color: var(--color-text-body);
        line-height: 1.2;
        max-width: 95ch;
    }

    @media (width <= 768px) {
        .service-card {
            grid-template-columns: 1fr;
        }

        .service-header {
            width: 100%;
        }
    }
</style>