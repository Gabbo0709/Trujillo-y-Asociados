---
import { Image } from 'astro:assets';
import sealEmblem from '@landing/assets/images/sello-negro.png';

export interface AreaItem {
  title: string;
  description: string;
}

export interface Props {
  titleLine1?: string;
  titleLine2?: string;
  subtitle?: string;
  items?: AreaItem[];
}

const defaultItems: AreaItem[] = [
  {
    title: "Demandas por despido injustificado",
    description: "Asesoría para exigir la indemnización constitucional (3 meses de salario), prima de antigüedad y salarios vencidos."
  },
  {
    title: "Revisión de finiquitos y liquidaciones",
    description: "Verificación de que el cálculo al momento de terminar la relación laboral cumpla estrictamente con la Ley Federal del Trabajo (LFT)."
  },
  {
    title: "Conclusión de relación laboral",
    description: "Procedimientos para rescindir contratos por causas imputables al trabajador; actas administrativas y medidas disciplinarias conforme al reglamento interior del trabajo."
  },
  {
    title: "Contratación",
    description: "Elaboramos contratos de trabajo a la medida. Incluye cláusulas clave como no competencia, confidencialidad, teletrabajo, subcontratación de servicios especializados, comisión mercantil, entre otros."
  }
];

const {
  titleLine1 = "Areas de resolución y",
  titleLine2 = "prevención de conflictos",
  subtitle = "Soluciones prácticas para trabajadores y empleadores",
  items = defaultItems
} = Astro.props;
---

<section id="asesoria" class="practice-areas-section" aria-labelledby="practice-areas-heading">
  <header class="section-header">
    <figure class="seal-container">

    </figure>
    <hgroup class="header-content">
      <h2 id="practice-areas-heading" class="section-title">
        <span class="title-line">{titleLine1}</span>
        <span class="title-line">{titleLine2}</span>
      </h2>
      <p class="section-subtitle">{subtitle}</p>
    </hgroup>
  </header>

  <ul class="items-list" role="list">
    {items.map((item) => (
      <li class="area-item">
        <article class="area-card">
          <h3 class="area-title">{item.title}</h3>
          <p class="area-description">{item.description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .practice-areas-section {
    background-color: var(--color-bg-primary);
    color: hsl(var(--color-accent));
    padding-block: var(--space-16);
    padding-inline: max(var(--space-6), calc((100% - var(--max-width-landing)) / 2 + var(--space-6)));
    width: 100%;
  }

  .section-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.4);
  }

  .seal-container {
    margin: 0;
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    justify-self: center;
  }

  .seal-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.15));
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 3.8rem);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-accent));
    line-height: 1.15;
    margin: 0;
    text-align: center;
  }

  .title-line {
    display: block;
    text-align: center;
  }

  .section-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
    font-weight: 500;
    text-align: center;
  }

  .items-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .area-item {
    padding-block: var(--space-6);
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.4);
  }

  .area-item:last-child {
    border-bottom: none;
  }

  .area-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .area-title {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-accent));
    line-height: 1.3;
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .area-title::before {
    content: '';
    width: 10px;
    height: 10px;
    background-color: #ffffff;
    display: inline-block;
    flex-shrink: 0;
    margin-top: 0.45em;
  }

  .area-description {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: hsl(var(--color-accent));
    line-height: 1.6;
    margin: 0;
    opacity: 0.95;
  }

  @media (min-width: 768px) {
    .section-header {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
      align-items: center;
    }

    .seal-container {
      justify-self: start;
      margin-left: 2em;
      width: 140px;
      height: 140px;
    }

    .header-content {
      align-items: flex-end; /* Keep the block on the right */
      text-align: center;
      margin-right: 2em;
    }

    .section-title {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center; /* Center the title lines relative to each other */
    }

    .title-line {
      display: block;
      text-align: center;
    }

    .section-subtitle {
      text-align: center;
      margin-top: var(--space-2);
    }

    .area-card {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
