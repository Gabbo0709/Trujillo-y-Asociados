---
import { Image } from 'astro:assets';
import sealEmblem from '@landing/assets/images/coin.png';

export interface AreaItem {
  title: string;
  description: string;
}

export interface Props {
  titleLine1?: string;
  titleLine2?: string;
  subtitle?: string;
  items?: AreaItem[];
}

const defaultItems: AreaItem[] = [
  {
    title: "Asesoría Preventiva",
    description: "Nuestro equipo de abogados no solo resuelve conflictos, también aporta un asesoramiento para evitarlos antes de que sucedan y garantizar de este modo el cumplimiento normativo, para lograr un mejor entorno laboral."
  },
  {
    title: "Contratación",
    description: "Elaboración, revisión y actualización de los contratos de trabajo a la medida de sus necesidades (por obra o tiempo determinado, por temporada o por tiempo indefinido, sujeto a prueba o capacitación inicial)."
  },
  {
    title: "Revisión de finiquitos y liquidaciones",
    description: "Verificación de que el cálculo al momento de terminar la relación laboral cumpla estrictamente con lo previsto en la Ley Federal del Trabajo, así como elaboración y ratificación de convenios de terminación de la relación de trabajo."
  },
  {
    title: "Demandas por despido injustificado",
    description: "Asesoría para exigir la indemnización constitucional (3 meses de salario) o reinstalación, prima de antigüedad y salarios vencidos, así como las prestaciones adeudadas."
  }
];

const {
  subtitle = "Ofrecemos una gama completa de servicios que abarcan todos los aspectos del derecho laboral. Nuestro enfoque se centra en brindar soluciones prácticas y efectivas tanto para trabajadores como para los patrones, lo que redunda en otorgar una asesoría integral más certera y eficaz a nuestros clientes.",
  items = defaultItems
} = Astro.props;

---

<section id="asesoria" class="practice-areas-section" aria-labelledby="practice-areas-heading">
  <header class="section-header">
    <figure class="seal-container">
      <Image 
        src={sealEmblem} 
        alt="Emblema Sello Trujillo & Asociados" 
        width={130}
        height={130}
        sizes="(max-width: 768px) 100vw, 25vw"
        loading="lazy"
        decoding="async"
        class="seal-image"
      />
    </figure>
    <hgroup class="header-content">
      <h2 id="practice-areas-heading" class="section-title">
        <span class="title-line">Áreas de resolución y</span>
        <span class="title-line">prevención de conflictos</span>
      </h2>
      <p class="section-subtitle">{subtitle}</p>
    </hgroup>
  </header>

  <ul class="items-list">
    {items.map((item) => (
      <li class="area-item">
        <article class="area-card">
          <h3 class="area-title">{item.title}</h3>
          <p class="area-description">{item.description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .practice-areas-section {
    background-color: var(--color-bg-primary);
    color: hsl(var(--color-accent));
    padding-block: var(--space-16);
    padding-inline: var(--layout-padding-inline);
    width: 100%;
  }

  .section-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.4);
  }

  .seal-container {
    margin: 0;
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    justify-self: center;
  }

  .seal-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.15));
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: var(--text-title);
    font-weight: var(--font-weight-medium);
    color: hsl(var(--color-accent));
    line-height: 1.15;
    margin: 0;
    text-align: center;
  }

  .title-line {
    display: block;
    text-align: center;
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: #ffffff;
    line-height: 1.6;
    font-weight: var(--font-weight-medium);
    text-align: center;
    text-wrap: pretty;
  }

  .items-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .area-item {
    padding-block: var(--space-6);
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.4);
  }

  .area-item:last-child {
    border-bottom: none;
  }

  .area-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .area-title {
    font-family: var(--font-sans);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-medium);
    color: hsl(var(--color-accent));
    line-height: 1.6;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .area-title::before {
    content: '';
    width: 10px;
    height: 10px;
    background-color: #ffffff;
    display: inline-block;
    flex-shrink: 0;
  }

  .area-description {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    margin: 0;
    opacity: 0.95;
  }

  @media (width >= 768px) {
    .section-header {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
      align-items: center;
    }

    .seal-container {
      justify-self: start;
      margin-left: 2em;
      width: 140px;
      height: 140px;
    }

    .header-content {
      align-items: flex-end;
      text-align: right;
    }

    .section-title,
    .title-line,
    .section-subtitle {
      text-align: right;
    }

    .section-subtitle {
      max-width: 85ch;
      width: 100%;
    }

    .area-card {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
