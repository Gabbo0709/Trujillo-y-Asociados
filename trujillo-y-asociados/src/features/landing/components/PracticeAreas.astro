---
export interface AreaItem {
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  items?: AreaItem[];
}

const defaultItems: AreaItem[] = [
  {
    title: "Demandas por despido injustificado",
    description: "Asesoría integral para exigir la indemnización constitucional (3 meses de salario), prima de antigüedad, salarios vencidos y prestaciones devengadas."
  },
  {
    title: "Asesoría laboral preventiva a empresas",
    description: "Auditoría de contratos individuales y colectivos, elaboración de reglamentos internos de trabajo y estrategias para mitigar contingencias legales."
  },
  {
    title: "Finiquitos, liquidaciones y negociaciones",
    description: "Cálculo preciso y mediación estratégica en convenios de terminación de la relación laboral ante los Centros de Conciliación."
  },
  {
    title: "Resguardo patrimonial y laboral intergeneracional",
    description: "Protección de activos empresariales y continuidad operativa en estructuras familiares y esquemas de responsabilidad laboral."
  }
];

const {
  title = "Áreas de resolución y prevención de conflictos",
  subtitle = "Soluciones prácticas y estratégicas para trabajadores y empleadores",
  items = defaultItems
} = Astro.props;
---

<section id="asesoria" class="practice-areas-section" aria-labelledby="practice-areas-heading">
  <header class="header-column">
    <h2 id="practice-areas-heading" class="section-title">
      {title}
    </h2>
    <p class="section-subtitle">{subtitle}</p>
  </header>

  <ul class="items-list" role="list">
    {items.map((item) => (
      <li class="area-item">
        <article class="area-card">
          <h3 class="area-title">{item.title}</h3>
          <p class="area-description">{item.description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .practice-areas-section {
    background-color: var(--color-bg-primary);
    color: hsl(var(--color-chocolate-alto-hsl));
    padding-block: var(--space-16);
    padding-inline: max(var(--space-6), calc((100% - var(--max-width-landing)) / 2 + var(--space-6)));
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .header-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-self: center;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-terracota-legal-hsl));
    line-height: 1.2;
    margin: 0;
  }

  .section-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: hsla(var(--color-chocolate-alto-hsl), 0.85);
    line-height: 1.5;
    margin: 0;
  }

  .items-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .area-item {
    padding-block: var(--space-6);
    border-top: 1px solid hsla(var(--color-chocolate-alto-hsl), 0.25);
  }

  .area-item:last-child {
    border-bottom: 1px solid hsla(var(--color-chocolate-alto-hsl), 0.25);
  }

  .area-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .area-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-terracota-legal-hsl));
    line-height: 1.3;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .area-title::before {
    content: '';
    width: 8px;
    height: 8px;
    background-color: hsl(var(--color-terracota-legal-hsl));
    display: inline-block;
    flex-shrink: 0;
  }

  .area-description {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: hsla(var(--color-chocolate-alto-hsl), 0.9);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 768px) {
    .practice-areas-section {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-12);
    }

    .area-card {
      grid-template-columns: 1fr 1.5fr;
      gap: var(--space-6);
      align-items: start;
    }
  }
</style>

