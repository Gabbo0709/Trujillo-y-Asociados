---
import { Image } from 'astro:assets';
import heroBg from '@landing/assets/images/bg-library.webp';
import { ROUTES } from '@shared/constants/navigation';
---

<section class="hero-module" aria-labelledby="hero-heading">
  <article class="hero-presentation">
    <header class="hero-header">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title-group">Asesoría en <strong class="hero-badge">CDMX</strong></span>
        Derecho Laboral
      </h1>
    </header>
    
    <aside class="hero-cta-section">
      <a 
        href={ROUTES.CONTACT_FORM}
        class="hero-cta-link"
        aria-label="Agendar una consulta para evaluación gratuita"
      >
        <span class="hero-cta-text">Agendar una Consulta</span>
        <span class="hero-cta-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </span>
      </a>
      <p class="hero-evaluation-text">
        Evaluación gratuita a su caso.
      </p>
    </aside>
  </article>
  <figure class="hero-media">
    <Image 
      src={heroBg} 
      alt="Biblioteca Trujillo y Asociados" 
      loading="eager" 
      fetchpriority="high"
      decoding="sync"
      format="avif"
      widths={[360, 640, 768, 1024, 1280, 1536, 1920]}
      sizes="100vw"
      class="hero-bg-image"
    />

  </figure>
</section>

<style>
  .hero-module {
    width: 100%;
    display: flex;
    flex-direction: column;
    flex-flow: column-reverse;
  }

  .hero-media {
    position: relative;
    display: grid;
    width: 100%;
    place-items: end center;
    margin: 0;
    height: 50dvh;
    overflow: hidden;
  }

  .hero-bg-image {
    position: relative;
    inset: 0;
    width: 100%;
    max-height: 50dvh;
    object-fit: cover;
    object-position: center;
    display: block;
    z-index: -1;
  }

  @media (width < 768px) {
    .hero-media,
    .hero-bg-image {
      max-height: 40dvh;
    }
  }

  .hero-presentation {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-title);
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid hsla(var(--color-capuchino-white-hsl), 0.2);
    height: 100%;
    min-height: 35dvh;
  }

  @media (width >= 768px) {
    .hero-presentation {
      grid-template-columns: 3fr 1fr;
    }
  }

  .hero-header {
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-heading);
    margin: 0;
    color: var(--color-text-muted);
    padding-left: var(--space-12);
  }

  .hero-title-group {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }

  .hero-badge {
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    font-size: clamp(2rem, 0.5em, 2.5rem);
    font-weight: var(--font-weight-extrabold);
    padding: 0.5em 1em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-block;
    align-self: center;
    margin-top: 1rem;
    line-height: 1;
  }

  @media (width < 768px) {
    .hero-badge {
      margin-top: 0.5rem;
      font-size: clamp(0.9rem, 0.5em, 1.1rem);
    }

    .hero-title {
      font-size: var(--text-subheading);
      padding-inline: var(--layout-padding-inline);
    }
  }

  .hero-cta-section {
    background-color: #3F1F13;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero-evaluation-text {
    order: 2;
    font-style: italic;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-bg-surface);
    padding-inline: var(--space-8);
    padding-bottom: var(--space-8);
    opacity: 0.9;
    line-height: 1;
    margin: 0;
  }

  .hero-cta-link {
    order: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    padding: var(--space-6);
    text-decoration: none;
    width: 100%;
    transition: background-color var(--ease-smooth);
  }

  .hero-cta-link:hover {
    background-color: var(--color-bg-surface);
  }

  .hero-cta-text {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
  }

  .hero-cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--ease-smooth);
  }

  .hero-cta-link:hover .hero-cta-icon {
    transform: translate(4px, -4px);
  }

  @media (width >= 768px) {
    .hero-cta-section {
      grid-column: span 1 / span 1;
      border-top: none;
      border-left: 1px solid hsla(var(--color-capuchino-white-hsl), 0.2);
      gap: var(--space-4);
    }

    .hero-evaluation-text {
      order: 1;
      padding-bottom: var(--space-4);
    }
  }
</style>
