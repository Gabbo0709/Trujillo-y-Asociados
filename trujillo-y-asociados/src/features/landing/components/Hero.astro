---
import { getImage } from 'astro:assets';
import heroBgDesktop from '@landing/assets/images/bg-library.png';
import heroBgMobile from '@landing/assets/images/bg-library.webp';
import { ROUTES } from '@shared/constants/navigation';

const optimizedDesktop = await getImage({
  src: heroBgDesktop,
  format: 'avif',
  width: 1920
});

const optimizedMobile = await getImage({
  src: heroBgMobile,
  format: 'avif',
  width: 1023
});
---

<section class="hero-module" aria-labelledby="hero-heading">
  <article class="hero-presentation">
    <header class="hero-header">
      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title-group">
          Asesoría en 
          <strong class="hero-badge">
            <span class="hero-badge-row">CDMX &amp;</span>
            <span class="hero-badge-row">EDOMEX</span>
          </strong>
        </span>
        <span class="hero-title-main">Derecho Laboral</span>
      </h1>
    </header>
    
    <aside class="hero-cta-section">
      <a 
        href={ROUTES.CONTACT_FORM}
        class="hero-cta-link"
        aria-label="Agendar una consulta para evaluación gratuita"
      >
        <span class="hero-cta-text">Agendar una Consulta</span>
        <span class="hero-cta-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </span>
      </a>
      <p class="hero-evaluation-text">
        <span class="hero-eval-line">Evaluación</span>
        <span class="hero-eval-line">gratuita a</span>
        <span class="hero-eval-line">su caso.</span>
      </p>
    </aside>
  </article>
  <figure class="hero-media">
    <picture class="hero-picture-wrapper">
      <source 
        media="(min-width: 1024px)" 
        srcset={optimizedDesktop.src} 
      />
      <!-- Fallback (Mobile) y controlador de LCP -->
      <img 
        src={optimizedMobile.src} 
        alt="Biblioteca Trujillo y Asociados" 
        width={optimizedMobile.attributes.width}
        height={optimizedMobile.attributes.height}
        loading="eager" 
        fetchpriority="high"
        decoding="sync"
        class="hero-bg-image"
      />
    </picture>

  </figure>
</section>

<style>
  .hero-module {
    width: 100%;
    display: flex;
    flex-direction: column;
    flex-flow: column-reverse;
  }

  .hero-media {
    display: block;
    width: 100%;
    place-items: center;
    margin: 0;
    height: 50dvh;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .hero-bg-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -1;
  }

  @media (width < 768px) {
    .hero-media {
      max-height: 40dvh;
    }
  }

  .hero-presentation {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-title);
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid hsla(var(--color-capuchino-white-hsl), 0.2);
    height: 100%;
    min-height: 35dvh;
  }

  @media (width >= 768px) {
    .hero-presentation {
      grid-template-columns: 3fr 1fr;
    }

  }

  .hero-header {
    padding-block: var(--space-8);
    padding-inline: var(--layout-padding-inline);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero-title {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-heading);
    margin: 0 auto;
    color: var(--color-text-muted);
    text-align: center;
  }

  .hero-title-group {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
  }

  .hero-title-main {
    display: block;
    text-align: center;
  }

  .hero-badge {
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-extrabold);
    padding: 0.35em 0.65em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: center;
    margin-top: 0.25rem;
    line-height: 1.05;
  }

  .hero-badge-row {
    display: block;
    white-space: nowrap;
  }

  @media (width < 768px) {
    .hero-badge {
      margin-top: 0.25rem;
      font-size: var(--text-xs);
      padding: 0.25em 0.45em;
    }
  }

  @media (width <= 480px) {
    .hero-header {
      padding-inline: var(--space-4);
    }

    .hero-title {
      font-size: clamp(1.65rem, 1.25rem + 3vw, 2.15rem);
    }

    .hero-title-main {
      white-space: nowrap;
    }
  }

  .hero-cta-section {
    background-color: #3F1F13;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero-evaluation-text {
    order: 2;
    font-style: italic;
    font-size: var(--text-title);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-bg-surface);
    padding-inline: var(--space-8);
    padding-bottom: var(--space-8);
    opacity: 0.9;
    line-height: 1.1;
    margin: 0;
    text-align: center;
  }

  .hero-eval-line {
    display: inline;
  }

  .hero-cta-link {
    order: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-bg-surface);
    color: var(--color-text-body);
    padding: var(--space-6);
    text-decoration: none;
    width: 100%;
    transition: background-color var(--ease-smooth);
  }

  .hero-cta-link:hover {
    background-color: var(--color-bg-surface);
  }

  .hero-cta-text {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
  }

  .hero-cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--ease-smooth);
  }

  .hero-cta-link:hover .hero-cta-icon {
    transform: translate(4px, -4px);
  }

  @media (768px <= width <= 1200px) {
    .hero-presentation {
      min-height: 15dvh;
    }

    .hero-header {
      align-content: center;
    }

    .hero-badge {
      font-size: var(--text-base);
    }

    .hero-cta-link {
      justify-content: space-evenly;
    }

    .hero-cta-text {
      font-size: var(--text-base);
    }

    .hero-evaluation-text {
      font-size: var(--text-xl);
    }
  }

  @media (width >= 768px) {
    .hero-cta-section {
      grid-column: span 1 / span 1;
      border-top: none;
      border-left: 1px solid hsla(var(--color-capuchino-white-hsl), 0.2);
      gap: var(--space-4);
    }

    .hero-evaluation-text {
      order: 1;
      padding-bottom: var(--space-4);
      text-align: left;
    }

    .hero-eval-line {
      display: block;
    }
  }
</style>
