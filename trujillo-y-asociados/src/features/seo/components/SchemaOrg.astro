---
import type { SchemaData, LegalServiceSchema } from '@seo/types/seo.types';

interface Props {
  schema?: SchemaData;
  description: string;
  canonicalUrl: URL;
}

const { schema, description, canonicalUrl } = Astro.props;

const defaultSchema: LegalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Trujillo & Asociados',
  url: Astro.site?.toString() ?? canonicalUrl.toString(),
  logo: new URL('/seo/og-image.png', Astro.site ?? canonicalUrl).toString(),
  description: description,
  telephone: '+525573408674',
  priceRange: '$$$',
  areaServed: 'Ciudad de México',
  knowsAbout: ['Derecho Laboral', 'Asesoría Corporativa', 'Seguridad Social', 'Cumplimiento Normativo', 'Litigio Laboral'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C. Guaymas 8–Interior 401, Roma Nte.',
    addressLocality: 'Cuauhtémoc',
    addressRegion: 'CDMX',
    postalCode: '06700',
    addressCountry: 'MX'
  }
};

const jsonLdData = schema ?? defaultSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} is:inline />