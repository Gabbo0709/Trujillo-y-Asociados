---
import type { SchemaData, LegalServiceSchema } from '@seo/types/seo.types';
import { COMPANY_CONFIG } from '@shared/constants/company.config';

interface Props {
  schema?: SchemaData;
  description: string;
  canonicalUrl: URL;
}

const { schema, description, canonicalUrl } = Astro.props;

const defaultSchema: LegalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: COMPANY_CONFIG.name,
  legalName: COMPANY_CONFIG.legalName,
  taxID: COMPANY_CONFIG.taxId,
  vatID: COMPANY_CONFIG.taxId,
  foundingDate: COMPANY_CONFIG.foundationDate,
  url: canonicalUrl.toString(),
  logo: new URL('/seo/og-image.png', Astro.site ?? canonicalUrl).toString(),
  description: description,
  telephone: COMPANY_CONFIG.contact.phoneLandline,
  email: COMPANY_CONFIG.contact.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY_CONFIG.address.streetAddress,
    addressLocality: COMPANY_CONFIG.address.addressLocality,
    addressRegion: COMPANY_CONFIG.address.addressRegion,
    postalCode: COMPANY_CONFIG.address.postalCode,
    addressCountry: COMPANY_CONFIG.address.addressCountry
  },
  areaServed: COMPANY_CONFIG.serviceAreas.map((area) => ({
    '@type': area.type,
    name: area.name
  })),
  geo: {
    '@type': 'GeoCoordinates',
    latitude: COMPANY_CONFIG.geo.latitude,
    longitude: COMPANY_CONFIG.geo.longitude
  },
  openingHours: COMPANY_CONFIG.openingHours
};

const jsonLdData = schema ?? defaultSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} is:inline />