---
interface Props {
  title: string;
  description: string;
  canonicalUrl: URL;
  ogImage?: string;
}

const { title, description, canonicalUrl, ogImage } = Astro.props;
const siteUrl = Astro.site || new URL('https://trujillo-demo.netlify.app');
const absoluteOgImageUrl = new URL(ogImage || '/images/og-default.jpg', siteUrl);
const siteName = 'Trujillo &amp; Asociados Abogados';
---

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={`${title} | Trujillo &amp; Asociados`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`Imagen descriptiva de ${title}`} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_MX" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={`${title} | Trujillo &amp; Asociados`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImageUrl} />