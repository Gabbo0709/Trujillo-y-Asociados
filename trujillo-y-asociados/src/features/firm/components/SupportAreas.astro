---
export interface SupportAreaItem {
  category: string;
  description: string;
}

export interface Props {
  title?: string;
  areas?: SupportAreaItem[];
  disclaimer?: string;
}

const defaultAreas: SupportAreaItem[] = [
  {
    category: "Asesoría laboral preventiva",
    description: "Auditoría integral de contratos individuales y colectivos, reglamentos internos de trabajo y esquemas de cumplimiento para prevenir contingencias y sanciones ante autoridades laborales."
  },
  {
    category: "Litigio y defensa laboral",
    description: "Representación estratégica en conflictos ante el Centro de Conciliación Laboral y Tribunales Laborales en CDMX y ámbito federal, salvaguardando derechos laborales e indemnizaciones."
  },
  {
    category: "Reestructuración y negociación corporativa",
    description: "Mediación en rescisiones, convenios de liquidación y procesos de sustitución patronal con estricto apego a la Ley Federal del Trabajo y máxima protección patrimonial."
  },
  {
    category: "Preservación del patrimonio laboral",
    description: "Defensa legal especializada orientada a resguardar la estabilidad operativa de personas clave y preservar los activos familiares construidos a través del trabajo de toda una vida."
  }
];

const {
  title = "Nuestras áreas de soporte a clientes",
  areas = defaultAreas,
  disclaimer = "Trujillo & Asociados opera bajo estrictos estándares de confidencialidad y ética profesional. Cada área de práctica es dirigida por especialistas de amplia experiencia en litigio y consultoría laboral."
} = Astro.props;
---

<section class="support-areas-section" aria-labelledby="support-areas-title">
  <div class="support-areas-container">
    <!-- Top Component Grid Header -->
    <div class="header-alignment">
      <h2 id="support-areas-title" class="title-label">{title}</h2>
    </div>

    <!-- Tabular Rows Matrix Stack -->
    <div class="tabular-stack">
      {areas.map((area) => (
        <article class="tabular-row">
          <div class="category-col">
            <h3 class="category-name">{area.category}</h3>
          </div>
          <div class="description-col">
            <p class="description-text">{area.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Footer Disclaimer Callout Segment -->
    <div class="disclaimer-block">
      <p class="disclaimer-text">{disclaimer}</p>
    </div>
  </div>
</section>

<style>
  .support-areas-section {
    background-color: var(--color-bg-primary);
    color: hsl(var(--color-chocolate-alto-hsl));
    padding-block: var(--space-16);
    padding-inline: max(var(--space-6), calc((100% - var(--max-width-landing)) / 2 + var(--space-6)));
    width: 100%;
    border-top: 1px solid hsla(var(--color-chocolate-alto-hsl), 0.15);
  }

  .support-areas-container {
    max-width: var(--max-width-landing);
    margin-inline: auto;
  }

  .header-alignment {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-8);
  }

  .title-label {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-brand-primary));
    line-height: 1.2;
    max-width: 600px;
    margin: 0;
    text-align: right;
  }

  @media (max-width: 768px) {
    .header-alignment {
      justify-content: flex-start;
    }
    .title-label {
      text-align: left;
    }
  }

  .tabular-stack {
    border-top: 1px solid hsla(var(--color-chocolate-alto-hsl), 0.25);
    margin-bottom: var(--space-8);
  }

  .tabular-row {
    border-bottom: 1px solid hsla(var(--color-chocolate-alto-hsl), 0.25);
    padding-block: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .tabular-row {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: var(--space-8);
      padding-block: var(--space-8);
    }
  }

  .category-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: hsl(var(--color-brand-primary));
    margin: 0;
    line-height: 1.3;
  }

  .description-text {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: hsl(var(--color-chocolate-alto-hsl));
    margin: 0;
    opacity: 0.9;
  }

  .disclaimer-block {
    background-color: hsl(var(--color-capuchino-white-hsl));
    border: 1px solid hsla(var(--color-brand-primary), 0.2);
    border-radius: var(--radius-brand);
    padding: var(--space-6);
    display: flex;
    justify-content: flex-end;
  }

  .disclaimer-text {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 700px;
    color: hsl(var(--color-chocolate-alto-hsl));
    margin: 0;
  }
</style>
