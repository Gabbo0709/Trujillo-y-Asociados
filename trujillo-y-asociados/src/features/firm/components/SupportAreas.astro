---
export interface SupportAreaItem {
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  items?: SupportAreaItem[];
  disclaimer?: string;
}

const defaultItems: SupportAreaItem[] = [
  {
    title: "Despido Injustificado",
    description:
      "Brindamos asesoría en caso de tener algún conflicto con la empresa ya sea por despido injustificado o por incumplimiento en sus obligaciones del patrón tales como retraso o falta de pago de salario, reducción de salario, modificación unilateral de las condiciones de trabajo, falta de pago de prestaciones de ley (aguinaldo, vacaciones, prima vacacional, comisiones, bonos, reparto de utilidades, ahorro).",
  },
  {
    title: "Disputas y Litigios Fiscales",
    description:
      "Nuestra firma ofrece una representación firme en controversias fiscales federales de gran envergadura. Desde la defensa en auditorías hasta litigios de apelación complejos, salvaguardamos los activos de nuestros clientes mediante una estrategia legal meticulosa y rigor intelectual.",
  },
  {
    title: "Asesoría Fiscal Internacional",
    description:
      "Navegamos por el multifacético panorama jurisdiccional de las transacciones transfronterizas y la protección de activos globales para personas con un alto patrimonio neto y empresas multinacionales que buscan claridad experta en jurisdicciones complejas.",
  },
  {
    title: "Estrategia Fiscal de Sucesiones y Fideicomisos",
    description:
      "Implementamos marcos legales sofisticados diseñados para mitigar la exposición fiscal a través de las generaciones. Nos especializamos en la preservación del capital a través de una arquitectura de fideicomisos y un gobierno patrimonial intelectualmente rigurosos.",
  },
];

const {
  title = "Nuestras Áreas de soporte a clientes.",
  items = defaultItems,
  disclaimer = "Trujillo & Asociados opera con estricta confidencialidad. Cada área de práctica es gestionada por counsel líder con amplia experiencia en litigio.",
} = Astro.props;
---

<section
  id="areas-soporte"
  class="support-areas-section"
  aria-labelledby="support-areas-title"
>
  <header class="section-header">
    <h2 id="support-areas-title" class="section-title">{title}</h2>
  </header>

  <ul class="tabular-list" role="list">
    {
      items.map((item) => (
        <li class="tabular-row">
          <article class="support-card">
            <h3 class="category-name">{item.title}</h3>
            <p class="description-text">{item.description}</p>
          </article>
        </li>
      ))
    }
  </ul>

  {
    disclaimer && (
      <aside class="disclaimer-callout">
        <svg
          class="disclaimer-svg-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path class="disclaimer-svg-shield" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path class="disclaimer-svg-check" d="m9 12 2 2 4-4"></path>
        </svg>
        <span class="disclaimer-tag">Aviso de Confidencialidad & Ejercicio Profesional</span>
        <p class="disclaimer-text">{disclaimer}</p>
      </aside>
    )
  }
</section>

<style>
  .support-areas-section {
    background-color: var(--color-bg-primary);
    color: var(--color-text-body);
    padding-block: var(--space-16);
    padding-inline: var(--layout-padding-inline);
    width: 100%;
    box-sizing: border-box;
  }

  .section-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    color: var(--color-text-body);
    max-width: 16ch;
    margin: 0;
    text-align: right;
  }

  .tabular-list {
    list-style: none;
    margin: 0 0 var(--space-12) 0;
    padding: 0;
    border-top: 1px solid hsla(var(--color-brand-muted), 0.35);
  }

  .tabular-row {
    border-bottom: 1px solid hsla(var(--color-brand-muted), 0.35);
    padding-block: var(--space-8);
  }

  .support-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .category-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-body);
    margin: 0;
    line-height: 1.25;
  }

  .description-text {
    font-family: var(--font-sans);
    font-size: clamp(0.875rem, 1vw, 0.975rem);
    line-height: 1.6;
    color: var(--color-text-body);
    margin: 0;
    opacity: 0.95;
  }

  .disclaimer-callout {
    background-color: hsl(var(--color-brand-secondary));
    border-left: 4px solid var(--color-text-body);
    border-top: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-right: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-bottom: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-radius: 0;
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      "icon tag"
      "icon text";
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: start;
    margin-top: var(--space-8);
    box-sizing: border-box;
  }

  .disclaimer-svg-icon {
    grid-area: icon;
    min-width: 2rem;
    min-height: 2rem;
    max-width: 3.5rem;
    max-height: 3.5rem;
    color: var(--color-text-body);
    flex-shrink: 0;
    margin-top: 0.15rem;
    margin-right: 5em;
    align-self: center;
    transition: transform var(--ease-smooth), color var(--ease-smooth);
  }

  .disclaimer-svg-shield {
    stroke: var(--color-text-body);
    stroke-width: 1.5;
    transition: stroke var(--ease-smooth);
  }

  .disclaimer-svg-check {
    stroke: var(--color-text-body);
    stroke-width: 1.75;
    transition: stroke var(--ease-smooth);
  }

  .disclaimer-callout:hover .disclaimer-svg-icon {
    transform: scale(1.08);
  }

  .disclaimer-tag {
    grid-area: tag;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-body);
    opacity: 0.85;
  }

  .disclaimer-text {
    grid-area: text;
    font-family: var(--font-sans);
    font-size: clamp(0.875rem, 1vw, 0.975rem);
    line-height: 1.6;
    color: var(--color-text-body);
    margin: 0;
  }

  @media (width >= 768px) {
    .support-card {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
