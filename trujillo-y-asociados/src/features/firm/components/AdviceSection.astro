---
import { getImage } from "astro:assets";
import adviceBg from "@firm/assets/advice-bg.jpeg";

export interface Props {
    title?: string;
    disclaimer?: string;
}

const {
    title = "Confidencialidad y resguardo en cada caso.",
    disclaimer = "Trujillo y Asociados opera con estricta confidencialidad. Cada área de práctica es gestionada por counsel líder con amplia experiencia en litigio.",
} = Astro.props;

const optimizedBg = await getImage({
    src: adviceBg,
    width: 1920,
    height: 1080,
    format: "webp",
    quality: 80,
});
---
<section
  id="areas-soporte"
  class="advice-section"
  aria-labelledby="advice-firm-title"
  style={`--advice-bg-url: url('${optimizedBg.src}');`}
>
    <header class="advice-header">
        <h2 id="advice-firm-title" class="advice-heading">
            {title}
        </h2>
    </header>
  {
    disclaimer && (
      <aside class="disclaimer-callout">
        <svg
          class="disclaimer-svg-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path class="disclaimer-svg-shield" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path class="disclaimer-svg-check" d="m9 12 2 2 4-4"></path>
        </svg>
        <span class="disclaimer-tag">Aviso de Confidencialidad y Ejercicio Profesional</span>
        <p class="disclaimer-text">{disclaimer}</p>
      </aside>
    )
  }
</section>

<style>
  .advice-section {
    background-color: var(--color-bg-primary);
    background-image: 
        linear-gradient(to right, rgba(60, 20, 15, 0.85), rgba(60, 20, 15, 0.4)),
        var(--advice-bg-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--color-text-body);
    padding-block: var(--space-16);
    padding-inline: var(--layout-padding-inline);
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 90dvh;
  }

  .advice-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    max-width: 60ch;
  }

  .advice-heading {
    font-size: var(--text-title);
    font-weight: var(--font-weight-black);
    color: white;
    line-height: 1;
    margin: 0;
  }

  .disclaimer-callout {
    background-color: hsl(var(--color-brand-secondary));
    border-left: 4px solid var(--color-text-body);
    border-top: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-right: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-bottom: 1px solid hsla(var(--color-brand-muted), 0.15);
    border-radius: 0;
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      "icon tag"
      "icon text";
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: start;
    margin-top: var(--space-8);
    box-sizing: border-box;
    max-width: 60%;
    align-self: end;
  }

  @media (width < 1200px) {
    .disclaimer-callout {
      max-width: 100%;
    }
  }

  .disclaimer-svg-icon {
    grid-area: icon;
    min-width: 2rem;
    min-height: 2rem;
    max-width: 3.5rem;
    max-height: 3.5rem;
    color: var(--color-text-body);
    flex-shrink: 0;
    margin-top: 0.15rem;
    margin-right: 5em;
    align-self: center;
    transition: transform var(--ease-smooth), color var(--ease-smooth);
  }

  .disclaimer-svg-shield {
    stroke: var(--color-text-body);
    stroke-width: 1.5;
    transition: stroke var(--ease-smooth);
  }

  .disclaimer-svg-check {
    stroke: var(--color-text-body);
    stroke-width: 1.75;
    transition: stroke var(--ease-smooth);
  }

  .disclaimer-callout:hover .disclaimer-svg-icon {
    transform: scale(1.08);
  }

  .disclaimer-tag {
    grid-area: tag;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-body);
    opacity: 0.85;
  }

  .disclaimer-text {
    grid-area: text;
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 85ch;
    color: var(--color-text-body);
    margin: 0;
  }

  @media (width <= 768px) {
    .disclaimer-text {
        font-size: var(--text-xs);
    }
  }
</style>