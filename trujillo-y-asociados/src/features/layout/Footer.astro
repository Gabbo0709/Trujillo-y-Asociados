---
import { Image } from 'astro:assets';
import logo from '@layout/assets/images/logo-icon.png';
import { ROUTES, MAIN_NAV_ITEMS } from '@shared/constants/navigation';
import { COMPANY_CONFIG } from '@shared/constants/company.config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand">
    <a href={ROUTES.HOME} aria-label={`${COMPANY_CONFIG.name} Inicio`}>
      <Image 
        src={logo} 
        alt={`Logotipo oficial de ${COMPANY_CONFIG.name}`}
        widths={[64, 128, 192]} 
        sizes="(max-width: 768px) 64px, (max-width: 1024px) 128px, 192px"
        loading="lazy"
        class="footer-logo"
      />
    </a>
    <p class="footer-tagline">
      Asesoramiento legal experto para la compleja y exigente normativa <strong class="footer-highlight">Ley Federal del Trabajo</strong>
    </p>
  </div>

  <div class="footer-nav-section">
    <nav class="footer-nav" aria-label="Enlaces del pie de página">
      {MAIN_NAV_ITEMS.map((link) => (
        <a href={link.href} class="footer-link">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="footer-contact-block">
      <address class="footer-address">
        <a href="https://maps.app.goo.gl/ypJ2h25fwe5J2Yrr5" target="_blank" rel="noopener noreferrer" class="footer-map-link">
          {COMPANY_CONFIG.address.streetAddress}, Col. {COMPANY_CONFIG.address.neighborhood}<br/>
          {COMPANY_CONFIG.address.addressLocality}, {COMPANY_CONFIG.address.postalCode} {COMPANY_CONFIG.address.addressRegion}
        </a>
        <p class="footer-coverage-text">Sede Roma Norte | Cobertura en CDMX y Estado de México</p>
      </address>
      <a href={`mailto:${COMPANY_CONFIG.contact.email}`} class="footer-email">
        {COMPANY_CONFIG.contact.email}
      </a>
      <a href={`tel:${COMPANY_CONFIG.contact.phoneLandline}`} class="footer-email">
        Tel:&nbsp;{COMPANY_CONFIG.contact.phoneLandline}
      </a>
    </div>
  </div>

  <small class="footer-copyright">© {currentYear} {COMPANY_CONFIG.legalName} {COMPANY_CONFIG.capitalRegime}. Todos los derechos reservados.</small>
</footer>

<style>
  .site-footer {
    background-color: hsl(var(--color-brand-primary));
    color: hsl(var(--color-brand-secondary));
    border-top: 1px solid hsla(var(--color-brand-secondary), 0.1);
    padding-inline: var(--layout-padding-inline);
    padding-block: var(--space-16) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-content: center;
    gap: var(--space-12);
  }

  .footer-brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer-logo {
    display: block;
    height: auto;
    width: 80%;
  }

  .footer-highlight {
    display: block;
    margin-top: var(--space-1);
    font-weight: var(--font-weight-bold);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.4;
  }

  .footer-nav-section {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    width: 100%;
    gap: var(--space-6);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: hsla(var(--color-brand-secondary), 0.8);
    text-decoration: none;
    transition: color var(--ease-smooth);
    padding-block: var(--space-2);
    display: inline-block;
  }

  .footer-link:hover {
    color: var(--color-text-layout);
    text-decoration: underline;
  }

  .footer-contact-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    gap: var(--space-6);
  }

  .footer-address {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .footer-email {
    display: block;
    font-size: var(--text-sm);
    color: hsla(var(--color-brand-secondary), 0.9);
    text-decoration: none;
    margin-bottom: var(--space-3);
    transition: color var(--ease-smooth);
    padding-block: var(--space-2);
  }

  .footer-email:hover {
    color: var(--color-text-layout);
    text-decoration: underline;
  }

  .footer-map-link {
    color: hsla(var(--color-brand-secondary), 0.9);
    text-decoration: none;
    transition: color var(--ease-smooth);
    padding-block: var(--space-2);
    display: inline-block;
  }

  .footer-map-link:hover {
    color: var(--color-text-layout);
    text-decoration: underline;
  }

  .footer-coverage-text {
    font-size: var(--text-xs);
    color: hsla(var(--color-brand-secondary), 0.75);
    margin: var(--space-2) 0 0 0;
    line-height: 1.4;
  }

  .footer-copyright {
    font-size: var(--text-xs);
    text-align: left;
    opacity: 0.6;
    margin-bottom: var(--space-6);
  }

  @media (width <= 768px) {
    .site-footer {
      gap: var(--space-4);
    }

    .footer-contact-block {
      gap: var(--space-4);
    }

    .footer-nav-section {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .footer-brand {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-nav-section {
      text-align: center;
    }
  }
</style>
